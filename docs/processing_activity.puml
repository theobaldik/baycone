@startuml processing_activity

title Processing Activity
footer Version 1.0

start
:Scan Watch Directory;
note right
    ""Path.walk()"", pruning the ""_baycone_*""
    and "".baycone"" dirs instead of descending.
end note

if (supported file found) then (yes)
    if (size and mtime unchanged since previous scan) then (yes)
    else (no)
        note right: New, or still being written.
        :Skip file until next scan;
        stop
    endif
    if (failed before and unchanged since) then (no)
    else (yes)
        :Skip file until it is modified;
        stop
    endif
else (no)
    :Sleep ""poll_interval"";
    stop
endif

:Analyze File;
note right
    ""ffprobe"" - container, codecs,
    bitrates, channels, duration.
    Select audio tracks: original language
    first, then the preferred ones.
end note

if (video or selected audio outside limits) then (yes)
    if (video outside limits) then (yes)
        :Encode File 1<sup>st</sup> Pass;
        note right: "".baycone/passlogfiles/<relative path>""
        :Encode File 2<sup>nd</sup> Pass;
        note right: "".baycone/encoded/<relative path>.mp4""
    else (no)
        :Encode Audio, Copy Video;
        note right: Single pass, "".baycone/encoded/<relative path>.mp4""
    endif

    if (encoding succeeded) then (yes)
    else (no)
        :Log error;
        :Clear Work Directories;
        :Mark File Failed;
        note right: Original is left in place and retried once modified.
        stop
    endif
else (no)
    note right: A container mismatch or dropped audio tracks alone are fixed by the remux below.
endif

:Optimize File;
note right
    Remux with ""-c copy"", strip metadata,
    tag the audio tracks and move the moov
    atom to the front (""+faststart"").
end note

if (optimizing succeeded) then (yes)
else (no)
    :Log error;
    :Clear Work Directories;
    :Mark File Failed;
    note right: Original is left in place and retried once modified.
    stop
endif

:Move Original to Originals;
note right: ""_baycone_originals/<relative path>""

:Remove Directories Left Empty;
note right
    Bottom-up, ""rmdir"" only.
    Directories still holding files are kept.
end note

:Clear Work Directories;
note right: passlogfiles/ and encoded/

:Scan again without sleeping;

stop

@enduml
