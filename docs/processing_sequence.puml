@startuml processing_sequence

title Processing Sequence
footer Version 2.0

skinparam style strictuml

participant "Service" as service
participant "DirWatcher" as watcher
participant "State" as state
participant "LocatedFile" as located
participant "Encoder" as encoder

activate service

loop until stopped (SIGTERM / Ctrl+C)
    opt config.yml changed
        service -> service : reload config, rebuild watchers,\nretry failed files
    end

    loop for each watched location
        service -> watcher : get_new_file()
        activate watcher

        opt config.override.yml changed
            watcher -> watcher : reset to the base config, apply the override,\nunpause, retry failed files
        end

        alt location paused (waiting for free space)
            watcher --> service : None
        else
            watcher -> watcher : walk, prune special dirs,\nfilter by allowed_extensions
            watcher -> watcher : record size + mtime of every file

            alt a file unchanged since the previous scan\nand not failed with this signature
                watcher -> state : current file, attempts + 1
                activate state
                state --> watcher : saved
                deactivate state
                note right
                    Over ""MAX_ATTEMPTS"" means the service died on it
                    every time: the file is failed and skipped.
                end note
                watcher --> service : file_path
            else new, still being written or failed
                watcher --> service : None
            end
        end
        deactivate watcher

        opt file_path returned
            service -> located : resolve(file_path)
            activate located
            located --> service : location settings, job
            deactivate located

            service -> encoder : process(job)
            activate encoder
            encoder -> encoder : analyze, encode, optimize,\npublish, extract subtitles
            note right: See encoding_sequence.puml
            encoder --> service : output_file, or raises
            deactivate encoder

            alt published
                service -> service : archive_original()
            else InsufficientSpaceError
                service -> watcher : pause()
            else BayconeError or any other error
                service -> service : failed = True
            end

            service -> watcher : finish(file_path, failed)
            note right
                Always, in a ""finally"" that a stop signal reaches too.
                A failed file is skipped until it changes.
            end note
            activate watcher
            watcher -> state : clear current, remember failed
            deactivate watcher
        end
    end

    opt no file picked up
        service -> service : sleep(poll_interval)
    end
end

deactivate service

@enduml
