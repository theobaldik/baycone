@startuml processing_sequence

title Processing Sequence
footer Version 1.0

skinparam style strictuml

participant "Service" as service
participant "DirWatcher" as watcher
participant "Config" as config
participant "Encoder" as encoder

activate service

loop until stopped (SIGTERM / Ctrl+C)
    loop for each watched location
        service -> watcher : get_new_file()
        activate watcher

        opt override file mtime changed
            watcher -> config : load_config_override(location_config, base)
            activate config
            config --> watcher : reset to base, override applied
            deactivate config
        end

        watcher -> watcher : walk, prune special dirs,\nfilter by allowed_extensions
        watcher -> watcher : record size + mtime of every file

        alt file unchanged since previous scan\nand not failed in this state
            watcher --> service : file_path
        else new, still being written or failed
            watcher --> service : None
        end
        deactivate watcher

        opt file_path returned
            service -> encoder : process(file_path)
            activate encoder
            encoder -> encoder : analyze, encode,\noptimize, archive
            note right: See encoding_sequence.puml
            encoder --> service : succeeded
            deactivate encoder

            opt failed or raised
                service -> watcher : mark_failed(file_path)
                note right: Skipped until the file is modified.
            end
        end
    end

    opt no file picked up
        service -> service : sleep(poll_interval)
    end
end

deactivate service

@enduml
