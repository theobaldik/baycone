@startuml class_structure

title Class Structure
footer Version 1.0

skinparam style strictuml
hide circle

' Definitions

class Service {
    - _watchers : list<DirWatcher>
    - _encoder : Encoder
    - _stop_signal : bool
    + start() : int
    + stop()
    + main_loop()
    - _process_next() : bool
    - {static} _handle_sigterm(signum : int, frame)
}

class DirWatcher {
    - _dir_path : Path
    - _location_config : LocationConfig
    - _base_config : dict
    - _override_mtime : int | None
    - _signatures : dict<Path, Signature>
    - _failed : dict<Path, Signature>
    + special_dirs : SpecialDirs
    + get_new_file() : Path | None
    + mark_failed(file_path : Path)
    - _iter_files(extensions : set<str>) : Iterator<Path>
    - _reload_config_override()
    - _create_special_dirs()
}

class Analyzer <<static>> {
    + {static} analyze(file_path : Path) : FileInfo
    + {static} detect_crop(file_path : Path, video : VideoStream)
    - {static} _get_file_info(file_path : Path) : FileInfo
    - {static} _get_bitrate(stream : dict) : int
    - {static} _get_ffprobe_result(file_path : Path) : dict | None
}

class Encoder {
    - _processing_file : FileInfo
    + process(file_path : Path) : bool
    - _encode() : bool
    - _optimize(encoded : bool) : bool
    - _archive_original()
    - _cleanup_workdirs()
    - _run_ffmpeg(cmd : list<str>, step : str)
    - _log_progress(process : Popen, step : str)
    - _log_plan()
    - _video_filters() : dict<str, str>
    - _target_video_bitrate() : int
    - {static} _remove_empty_dirs(directory : Path, root_dir : Path)
    - {static} _clear_dir(directory : Path)
}

class FileInfo {
    + is_valid : bool
    + shall_remux : bool
    + duration : int
    + containers : list<str>
    + file_path : Path
    + relative_path : Path
    + passlog_path : Path
    + encoding_path : Path
    + original_path : Path
    + processed_path : Path
    + location_config : LocationConfig
    + special_dirs : SpecialDirs
}

class VideoStream <<dataclass>> {
    + shall_encode : bool
    + codec : str
    + bitrate : int
    + width : int
    + height : int
    + pix_fmt : str
    + color_transfer : str
    + crop_height : int
    + crop_top : int
    + is_hdr : bool
}

class AudioStream <<dataclass>> {
    + index : int
    + shall_encode : bool
    + codec : str
    + channel_bitrate : int
    + channels : int
    + lang : str
    + title : str
    + original : bool
    + special : bool
    + overall_bitrate : int
    + generate_track_name() : str
}

class AudioTrack <<dataclass>> {
    + stream : AudioStream
    + bitrate : int
    + default : bool
    + title : str
    + disposition : str
}

class audio <<module>> {
    + select_audio_tracks(streams, location_config) : list<AudioTrack>
    + normalize_language(code : str) : str
    + cap_bitrate(source : int, target : int) : int
}

class ffmpeg <<module>> {
    + get_cmd_encode_movie_pass_1() : list<str>
    + get_cmd_encode_movie_pass_2() : list<str>
    + get_cmd_encode_audio() : list<str>
    + get_cmd_optimize() : list<str>
    + get_cmd_ffprobe() : list<str>
}

class Serializable <<mixin>> {
    + from_dict(data : dict)
    + to_dict() : dict
}

class Config <<singleton>> {
    + ffmpeg_path : str
    + ffprobe_path : str
    + poll_interval : float
    + defaults : DefaultsConfig
    + locations : list<LocationConfig>
}

class DefaultsConfig <<dataclass>> {
    + allowed_extensions : list<str>
    + allowed_containers : list<str>
    + allowed_video_codecs : list<str>
    + allowed_audio_codecs : list<str>
    + target_extension : str
    + target_container : str
    + target_video_codec : str
    + target_video_bitrate : int
    + target_audio_codec : str
    + target_audio_channel_bitrate : int
    + target_audio_languages : list<str>
    + target_audio_channels : int
    + limit_video_bitrate : int
    + limit_video_height : int
    + limit_video_width : int
    + limit_audio_channel_bitrate : int
}

class LocationConfig <<dataclass>> {
    + path : str
    + abspath : Path
}

class SpecialDirs {
    + root_dir : Path
    + temp_dir : Path
    + passlog_dir : Path
    + encoded_dir : Path
    + originals_dir : Path
    + processed_dir : Path
    + exists() : bool
    + create()
}

class Constants {
    + {static} DIR_TEMP : Path
    + {static} DIR_PASSLOG : Path
    + {static} DIR_ENCODED : Path
    + {static} DIR_ORIGINALS : Path
    + {static} DIR_PROCESSED : Path
    + {static} SPECIAL_DIRS : tuple<Path>
    + {static} FILE_CONFIG_OVERRIDE : Path
    + {static} DIR_LOCATIONS : str
    + {static} FILE_CONFIG : str
    + {static} get_missing_env_variables() : list<str>
}

' Relations

Service o-- DirWatcher : one per location
Service --> Encoder

Encoder ..> Analyzer : uses
Encoder --> FileInfo : holds current
Encoder ..> ffmpeg : builds commands

Analyzer ..> ffmpeg : builds ffprobe command
Analyzer ..> FileInfo : creates

FileInfo *-- VideoStream
FileInfo *-- "0..*" AudioStream
FileInfo *-- "0..*" AudioTrack : selected
AudioTrack --> AudioStream

Analyzer ..> audio : selects tracks
audio ..> AudioTrack : creates
audio ..> LocationConfig : reads preferences
ffmpeg ..> AudioTrack : per-track arguments
FileInfo --> LocationConfig : resolved from Config
FileInfo --> SpecialDirs : resolved from Config

DirWatcher --> LocationConfig : resets and overrides
DirWatcher --> SpecialDirs : prunes from scan
DirWatcher ..> Config : load_config_override()

LocationConfig --|> DefaultsConfig
Config --|> Serializable
DefaultsConfig --|> Serializable
Config *-- DefaultsConfig
Config *-- "0..*" LocationConfig

SpecialDirs ..> Constants
LocationConfig ..> Constants
ffmpeg ..> Config : reads binary paths

note bottom of Config
    Module-level global singleton in ""baycone.config"".
    ""load_config()"" mutates it in place; every module
    reads from it at runtime.
end note

@enduml
