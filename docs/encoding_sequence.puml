@startuml encoding_sequence

title Encoding Sequence
footer \nVersion 2.0

skinparam style strictuml
skinparam backgroundColor #FFFFFE

participant "Caller\n(Service / CLI)" as caller
participant "Encoder" as encoder
participant "Analyzer" as analyzer
participant "ffmpeg" as cmd
participant "FFmpeg / FFprobe" as proc

activate caller
caller -> encoder : process(job, remux_only)
activate encoder

encoder -> encoder : signature of job.input_file\n(size + mtime)

encoder -> analyzer : analyze(input_file)
activate analyzer
analyzer -> proc : ffprobe streams and format
activate proc
proc --> analyzer : JSON
deactivate proc
analyzer -> proc : ffprobe packets near the declared end
activate proc
proc --> analyzer : timestamps
deactivate proc
note right
    No packet near the end:
    an aborted copy, ""is_valid"" is False.
end note
analyzer -> analyzer : flag shall_encode per video / audio stream,\nshall_remux for the container
analyzer -> analyzer : select audio tracks and subtitle streams
analyzer --> encoder : file_info
deactivate analyzer

alt invalid file or unsupported target codec
    encoder --> caller : raise InvalidFileError / EncodingError
end

opt remux_only
    encoder -> encoder : copy every stream
end

encoder -> encoder : _check_free_space()
note right
    ""InsufficientSpaceError"" before anything
    is written: the caller retries later.
end note

alt video or selected audio shall encode
    opt video shall encode
        encoder -> analyzer : detect_crop()\nkeyframes only, top / bottom bars
    end
    encoder -> encoder : cap the video bitrate in target codec terms,\nvideo filters: crop, scale to fit, tone map HDR

    alt video shall encode
        opt first pass not kept from an earlier run
            encoder -> cmd : get_cmd_encode_movie_pass_1(...)
            encoder -> proc : run 1st pass
            activate proc
            proc --> encoder : passlogfiles/passlog*
            deactivate proc
            encoder -> encoder : fsync stats,\nwrite passlogfiles/pass1.json
        end
        encoder -> cmd : get_cmd_encode_movie_pass_2(...)
        encoder -> proc : run 2nd pass
        activate proc
        proc --> encoder : encoded/<output name>
        deactivate proc
    else only audio shall encode
        encoder -> cmd : get_cmd_encode_audio(...)
        encoder -> proc : encode audio, copy video
        activate proc
        proc --> encoder : encoded/<output name>
        deactivate proc
    end
end

encoder -> cmd : get_cmd_optimize(...)
encoder -> proc : remux, tag audio, +faststart
activate proc
proc --> encoder : optimized/<output name>
deactivate proc

alt FFmpeg failed or stalled
    encoder --> caller : raise EncodingError
else input signature changed meanwhile
    encoder --> caller : raise SourceChangedError
end

encoder -> encoder : _publish()
note right
    fsync, rename to ""job.output_file"", fsync the directory.
    Across filesystems: a synced copy renamed into place.
end note

encoder -> encoder : _extract_subtitles()
note right: A failure here only warns.

encoder -> encoder : _cleanup_workdirs()
note right: Always, in a ""finally"". The passlog is kept for a resume.

encoder --> caller : job.output_file
deactivate encoder

opt caller is the service
    caller -> caller : archive_original()
    note right
        Moves the input to ""_baycone_originals/""
        and prunes only the directories it left empty.
    end note
end

note over caller, proc
    Every FFmpeg run is killed when neither its progress nor its output file moved
    for 30 minutes. If interrupted (SIGTERM / Ctrl+C), the running FFmpeg is killed,
    the work directories are cleared and the input stays in place.
end note

@enduml
