# Baycone configuration
#
# Copy this file to config.yml and point BAYCONE_CONFIG at it (the Docker image
# expects it at /config/config.yml).
#
# Only 'locations' is mandatory - every other key falls back to the value shown here.
# Each location inherits from 'defaults' and may override any of its fields individually.

# Paths to the FFmpeg binaries. Bare names are looked up on PATH.
ffmpeg_path: ffmpeg
ffprobe_path: ffprobe

# Seconds between directory scans.
poll_interval: 5.0

defaults:
  # Only files with these extensions are picked up.
  allowed_extensions: [ .mp4, .mkv, .avi, .m4v, .mov, .webm ]

  # A file is left as-is when its container, codecs and bitrates are all within these.
  allowed_containers: [ mp4 ]
  allowed_video_codecs: [ h264 ]
  allowed_audio_codecs: [ aac ]
  # Source bitrates are compared as their h264 / aac equivalent (e.g. hevc counts 1.5x), also when capping the encode.
  limit_video_bitrate: 2800         # kbps - an unknown bitrate is always re-encoded, also for audio
  # Larger videos are scaled down to fit a 16:9 box of this height (1080 -> 1920x1080). Values above 1080 exceed the
  # h264 level 4.1 the encode is tagged with.
  limit_video_height: 1080
  limit_audio_channel_bitrate: 96   # kbps per channel

  # Output written when a file does have to be re-encoded.
  target_extension: .mp4
  target_container: mp4
  target_video_codec: h264
  target_video_bitrate: 2250        # kbps - never upscales above the source bitrate
  target_audio_codec: aac
  target_audio_channel_bitrate: 64  # kbps per channel, multiplied by the channel count

  # Audio tracks kept, in this order. 'original' is the original language (the track flagged 'original', else the
  # first one) - list it later to move it back, e.g. [ pol, original ], or leave it out to drop it. The original is
  # still kept when none of the languages is found. One track per language, every other track is dropped - including
  # commentary and audio description tracks. ISO 639-2 codes, 'cze' and 'ces' are interchangeable.
  target_audio_languages: [ original, eng, cze ]
  # Preferred channel count when a language has several tracks. Without an exact match, the fewest channels above it
  # win, else the most channels below it.
  target_audio_channels: 2

  # Text subtitles extracted to '<name>.<2-letter lang>.srt' (e.g. movie.cs.srt) next to the processed file, always
  # as UTF-8. ISO 639-2 codes, in this order, one per language. Bitmap subtitles (PGS, VobSub) are skipped.
  # Empty (default) disables the extraction.
  target_subtitle_languages: [ ]

# Watched directories. Relative paths are resolved against BAYCONE_LOCATIONS.
locations:
  - path: movies

  - path: tv-shows
    # Any 'defaults' key can be overridden per location.
    target_video_bitrate: 1800
    limit_video_bitrate: 2200
